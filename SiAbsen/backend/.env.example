# Port server backend
PORT=3001

# Lingkungan: development | production
# Cookie Secure hanya aktif saat NODE_ENV=production
NODE_ENV=development

# Neon PostgreSQL - gunakan connection string "pooled" (host mengandung "-pooler")
# Contoh: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Neon direct connection (tanpa -pooler) - dipakai untuk menjalankan migrasi.
# Jika kosong, migrasi memakai DATABASE_URL.
DATABASE_URL_DIRECT=

# Origin frontend yang diizinkan (CORS) saat development
CORS_ORIGIN=http://localhost:5173

# Secret untuk menandatangani JWT (WAJIB diisi; jangan commit nilai asli)
JWT_SECRET=
# Masa berlaku token JWT
JWT_EXPIRES_IN=7d

# Kredensial awal akun guru (dipakai oleh scripts/seed-guru.js)
GURU_SEED_USERNAME=
GURU_SEED_PASSWORD=
# Nama lengkap guru awal; jika kosong memakai GURU_SEED_USERNAME
GURU_SEED_NAMA=
